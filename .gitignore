# Environment and secrets
.env
.env.*
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
.aws/
credentials
credentials/**
**/credentials/**
**/secrets/**

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node.js (Phase-II)
node_modules/
dist/

# Logs and runtime artifacts
*.log
logs/

# IDE and OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Build and infrastructure
.terraform/
cdk.out/
*.tfstate*

# Local generated data (keep repository metadata tracked)
datasets/raw/*
!datasets/raw/.gitkeep
datasets/processed/*
!datasets/processed/.gitkeep
!datasets/README.md
!datasets/dataset_description.pdf

# Temporary files
*.tmp
~$*.docx

# --- Banking module (Phase 2) ---
# The .env.* rule above also matches committed templates such as
# banking/.env.example, so templates are explicitly re-included.
!.env.example
!*.env.example

# Workload generator run records: produced by running the stack, not source.
banking/workload/runs/
banking/verify/runs/

# --- Telemetry module (Phase 3) ---
# Validation evidence is produced by running the stack, not source. Committed
# evidence for the phase lives in telemetry/evidence/ instead.
telemetry/validate/runs/

# Generated by `pip install -e telemetry/instrumentation`.
*.egg-info/
