# AORT Phase 3 - Telemetry stack local configuration
#
# Copy to .env before starting:   cp .env.example .env
#
# LOCAL-ONLY development values for a throwaway academic prototype. Not
# secrets; .env itself is git-ignored. The AWS phase must source credentials
# from IAM / Secrets Manager instead.

# --- PostgreSQL connection for postgres_exporter ---
# These MUST match banking/.env, since the exporter connects to the
# PostgreSQL instance the Phase 2 stack starts.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=aort_local_pg_admin
FINERACT_TENANT_DEFAULT_DB=fineract_default

# --- Grafana (visual verification only, not the digital twin) ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# --- Host port mappings (change if these clash with something local) ---
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
CADVISOR_HOST_PORT=8081
NODE_EXPORTER_HOST_PORT=9100
POSTGRES_EXPORTER_HOST_PORT=9187
OTLP_GRPC_HOST_PORT=4317
OTLP_HTTP_HOST_PORT=4318
OTEL_PROM_HOST_PORT=8889
