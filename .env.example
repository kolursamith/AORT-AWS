AORT_ENV=development
AORT_LOG_LEVEL=INFO
AORT_CONTROLLER_MODE=fixed
AORT_FIXED_BUDGET_RPS=5
AORT_DATABASE_URL=postgresql+psycopg://aort:aort_local_only@postgres:5432/aort
AORT_AUTH_SHARED_SECRET=replace-with-a-local-development-secret
AORT_ALLOWED_ATTACK_HOSTS=localhost,127.0.0.1,switch,beneficiary,remitter
AWS_REGION=ap-south-1
AORT_RESULTS_BUCKET=
