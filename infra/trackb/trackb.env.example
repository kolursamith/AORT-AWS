# AORTS Track B - local configuration template. SYNTHETIC MOCK ENVIRONMENT ONLY.
# Do not put real credentials here. Create your own .env with fresh random secrets:
#     python scripts/generate_env.py
# The CHANGE_ME values below are placeholders and will not work as-is.

# --- PostgreSQL (Docker publishes it on host port 55432 to avoid clashing with other local databases)
POSTGRES_PASSWORD=CHANGE_ME
AORTS_DATABASE_URL=postgresql+psycopg://aorts:CHANGE_ME@127.0.0.1:55432/aorts

# --- Service identities: key_id=identity:secret (secret >= 16 chars). Version suffix (-v1) enables rotation.
AORTS_SERVICE_KEYS=A1-v1=A1:CHANGE_ME_CHANGE_ME,A2-v1=A2:CHANGE_ME_CHANGE_ME
# Optional: pin which key id each identity signs with (otherwise the highest version is used)
AORTS_SIGNING_KEYS=

# --- Administrative token (separate from service keys) and lab switches
AORTS_ADMIN_TOKEN=CHANGE_ME
AORTS_ENABLE_ATTACK_CONTROLS=true
AORTS_ENABLE_FAULT_CONTROLS=true

# --- Track A controller adapter: mock | http
AORTS_CONTROLLER_MODE=mock
AORTS_CONTROLLER_BASE_URL=http://controller:8001
AORTS_CONTROLLER_TIMEOUT_SECONDS=2

# --- Status-check admission (illustrative values; calibrate to your machine)
AORTS_BANK_CHECK_RATE_PER_SEC=10
AORTS_BANK_CHECK_BURST=20
AORTS_ROUTE_CHECK_RATE_PER_SEC=15
AORTS_ROUTE_CHECK_BURST=30
AORTS_GLOBAL_CHECK_RATE_PER_SEC=60
AORTS_GLOBAL_CHECK_BURST=100
AORTS_TIER2_CREDIT_CAP=60
AORTS_TIER2_CREDIT_REFILL_PER_SEC=5
# Status-check bulkhead: >0 gives status checks their own worker pool (0 = shared with payments).
# docker-compose.yml sets 8; experiment scripts pin their own value.
# AORTS_SWITCH_CHECK_WORKERS=8

# --- Recovery: simulated "T+1" deadline in REAL seconds (not a calendar day)
AORTS_DEADLINE_SECONDS=120
AORTS_MAX_CHECKS_PER_TRANSACTION=6
AORTS_FALLBACK_BUDGET_PER_ROUTE=2

# --- Local adapters (no AWS needed). In AWS: sqs / eventbridge / dynamodb
AORTS_QUEUE_BACKEND=local
AORTS_EVENT_SINK=local
AORTS_TWIN_STORE=postgres
AORTS_LOG_LEVEL=INFO
