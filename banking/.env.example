# AORT Phase 2 - Banking Foundation local configuration
#
# Copy to .env before starting the stack:   cp .env.example .env
#
# These are LOCAL-ONLY development values for a throwaway academic prototype
# running on a developer machine. They are not secrets, and .env itself is
# git-ignored. Never reuse these values for the AWS phase - that phase must
# source its credentials from IAM / Secrets Manager, not from this file.

# --- PostgreSQL superuser (owns the instance, used only by initdb) ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=aort_local_pg_admin

# --- Application role Fineract connects as ---
FINERACT_DB_USER=fineract
FINERACT_DB_PASSWORD=aort_local_fineract

# --- Fineract's two databases: tenant registry + default tenant ---
FINERACT_TENANTS_DB=fineract_tenants
FINERACT_TENANT_DEFAULT_DB=fineract_default

# --- Fineract tenant settings ---
FINERACT_MASTER_PASSWORD=aort_local_master
FINERACT_TENANT_TIMEZONE=Asia/Kolkata

# --- Host port mappings (change if these clash with something local) ---
FINERACT_HOST_PORT=8080
POSTGRES_HOST_PORT=5432

# --- Workload generator target ---
# Fineract's default seeded superuser. Changing it is out of Phase 2 scope.
FINERACT_BASE_URL=http://localhost:8080/fineract-provider/api/v1
FINERACT_TENANT_ID=default
FINERACT_USERNAME=mifos
FINERACT_PASSWORD=password
